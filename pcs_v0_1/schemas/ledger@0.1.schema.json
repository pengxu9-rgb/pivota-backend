{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pivota.ai/schemas/pcs/ledger/0.1.json",
  "title": "Ledger@0.1 (Order/Payment/Return/Dispute State Machine + Events)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "effective_from",
    "source",
    "last_updated_at",
    "merchant",
    "order",
    "events"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "effective_from": { "type": "string", "format": "date-time" },
    "source": {
      "type": "string",
      "enum": ["shopify", "metafield", "metaobject", "external", "pivota_derived"]
    },
    "last_updated_at": { "type": "string", "format": "date-time" },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merchant_id", "platform", "shop_domain"],
      "properties": {
        "merchant_id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "enum": ["shopify"] },
        "shop_domain": { "type": "string", "minLength": 1 }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_gid", "order_name", "placed_at", "currency", "order_state", "payment_state"],
      "properties": {
        "order_gid": { "type": "string", "minLength": 1 },
        "order_name": { "type": "string", "minLength": 1 },
        "placed_at": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "order_state": {
          "type": "string",
          "enum": ["proposed", "authorized", "placed", "shipped", "delivered", "settled", "canceled"]
        },
        "payment_state": { "type": "string", "enum": ["authorized", "captured", "refunded", "voided"] },
        "shopify_financial_status": { "type": "string" },
        "shopify_fulfillment_status": { "type": "string" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total"],
          "properties": {
            "subtotal": { "$ref": "#/$defs/money" },
            "discount_total": { "$ref": "#/$defs/money" },
            "shipping_fee": { "$ref": "#/$defs/money" },
            "tax": { "$ref": "#/$defs/money" },
            "total": { "$ref": "#/$defs/money" }
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "items": { "$ref": "#/$defs/payment_transaction" }
    },
    "refunds": {
      "type": "array",
      "items": { "$ref": "#/$defs/refund" }
    },
    "fulfillments": {
      "type": "array",
      "items": { "$ref": "#/$defs/fulfillment" }
    },
    "returns": {
      "type": "array",
      "items": { "$ref": "#/$defs/return" }
    },
    "disputes": {
      "type": "array",
      "items": { "$ref": "#/$defs/dispute" }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ledger_event" }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "payment": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "return": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "dispute": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "order": { "properties": { "order_state": { "const": "shipped" } }, "required": ["order_state"] } },
        "required": ["order"]
      },
      "then": {
        "properties": {
          "fulfillments": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": { "tracking": { "type": "array", "minItems": 1 } },
              "required": ["tracking"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "returns": {
            "type": "array",
            "contains": { "type": "object", "properties": { "return_state": { "const": "refunded" } }, "required": ["return_state"] }
          }
        }
      },
      "then": {
        "properties": {
          "refunds": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      }
    },
    "ledger_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "occurred_at", "received_at", "source", "topic", "idempotency_key", "entity_refs"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "received_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["shopify_webhook", "shopify_poll", "external", "pivota"] },
        "topic": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 16 },
        "payload_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw_event_table": { "type": "string" },
            "raw_event_id": { "type": "string" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "entity_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_type", "entity_id"],
            "properties": {
              "entity_type": { "type": "string", "enum": ["order", "payment", "refund", "fulfillment", "return", "dispute"] },
              "entity_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "via_event"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "via_event": { "type": "string", "minLength": 1 }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "payment_transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_gid", "kind", "status", "processed_at", "amount"],
      "properties": {
        "transaction_gid": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["AUTHORIZATION", "SALE", "CAPTURE", "VOID", "REFUND"] },
        "status": { "type": "string" },
        "gateway": { "type": "string" },
        "authorization_code": { "type": "string" },
        "processed_at": { "type": "string", "format": "date-time" },
        "parent_transaction_gid": { "type": "string" },
        "amount": { "$ref": "#/$defs/money" }
      }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refund_gid", "created_at", "total_refunded"],
      "properties": {
        "refund_gid": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string" },
        "total_refunded": { "$ref": "#/$defs/money" },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "quantity", "restock_type"],
            "properties": {
              "sku": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 0 },
              "restock_type": { "type": "string" }
            }
          }
        }
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fulfillment_gid", "status", "created_at", "tracking"],
      "properties": {
        "fulfillment_gid": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "delivered_at": { "type": "string", "format": "date-time" },
        "tracking": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number"],
            "properties": {
              "number": { "type": "string", "minLength": 1 },
              "company": { "type": "string" },
              "url": { "type": "string" }
            }
          }
        }
      }
    },
    "return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rma_id", "return_state", "created_at"],
      "properties": {
        "rma_id": { "type": "string", "minLength": 1 },
        "shopify_return_gid": { "type": "string" },
        "return_state": {
          "type": "string",
          "enum": ["rma_created", "label_issued", "in_transit", "received", "refunded"]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "received_at": { "type": "string", "format": "date-time" },
        "reason_code": { "type": "string" }
      }
    },
    "dispute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispute_id", "dispute_state", "opened_at"],
      "properties": {
        "dispute_id": { "type": "string", "minLength": 1 },
        "shopify_dispute_gid": { "type": "string" },
        "dispute_state": { "type": "string", "enum": ["opened", "evidence_submitted", "won", "lost", "closed"] },
        "opened_at": { "type": "string", "format": "date-time" },
        "evidence_due_by": { "type": "string", "format": "date-time" },
        "finalized_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

