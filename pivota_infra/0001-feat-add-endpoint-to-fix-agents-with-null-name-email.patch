diff --git a/pivota_infra/routes/admin_fix_agents.py b/pivota_infra/routes/admin_fix_agents.py
new file mode 100644
index 00000000..5e5dc18f
--- /dev/null
+++ b/pivota_infra/routes/admin_fix_agents.py
@@ -0,0 +1,149 @@
+"""
+Admin endpoint to fix agents data
+Fixes agents with NULL name/email values
+"""
+
+from fastapi import APIRouter, Depends, HTTPException
+from db.database import database
+from utils.auth import get_current_user
+import logging
+
+router = APIRouter(prefix="/admin/fix", tags=["Admin Fix"])
+logger = logging.getLogger(__name__)
+
+@router.post("/agents-data")
+async def fix_agents_data(current_user: dict = Depends(get_current_user)):
+    """
+    Fix existing agents with NULL name/email
+    Only accessible by admin/employee users
+    """
+    # Check authorization
+    if current_user.get("role") not in ["admin", "employee"]:
+        raise HTTPException(status_code=403, detail="Not authorized")
+    
+    try:
+        # First check how many need fixing
+        check_query = """
+            SELECT COUNT(*) as count 
+            FROM agents 
+            WHERE name IS NULL OR name = '' OR email IS NULL OR email = ''
+        """
+        result = await database.fetch_one(check_query)
+        needs_fix = result["count"] if result else 0
+        
+        if needs_fix == 0:
+            return {
+                "status": "success",
+                "message": "All agents already have name and email",
+                "agents_fixed": 0
+            }
+        
+        # Get agents that need fixing (for logging)
+        agents_before = await database.fetch_all("""
+            SELECT agent_id, name, email 
+            FROM agents 
+            WHERE name IS NULL OR name = '' OR email IS NULL OR email = ''
+            LIMIT 10
+        """)
+        
+        logger.info(f"Fixing {needs_fix} agents with missing name/email")
+        
+        # Update agents with missing name
+        update_name = """
+            UPDATE agents 
+            SET name = CASE 
+                WHEN name IS NULL OR name = '' 
+                THEN 'Agent ' || SUBSTRING(agent_id FROM 7 FOR 8)
+                ELSE name
+            END
+            WHERE name IS NULL OR name = ''
+        """
+        await database.execute(update_name)
+        
+        # Update agents with missing email  
+        update_email = """
+            UPDATE agents 
+            SET email = CASE
+                WHEN email IS NULL OR email = ''
+                THEN agent_id || '@agents.pivota.app'
+                ELSE email
+            END
+            WHERE email IS NULL OR email = ''
+        """
+        await database.execute(update_email)
+        
+        # Get updated agents to show results
+        agents_after = await database.fetch_all("""
+            SELECT agent_id, name, email, status
+            FROM agents
+            ORDER BY created_at DESC
+            LIMIT 10
+        """)
+        
+        logger.info(f"✅ Fixed {needs_fix} agents with missing name/email")
+        
+        return {
+            "status": "success",
+            "message": f"Successfully fixed {needs_fix} agents",
+            "agents_fixed": needs_fix,
+            "sample_results": [
+                {
+                    "agent_id": a["agent_id"],
+                    "name": a["name"],
+                    "email": a["email"],
+                    "status": a["status"]
+                }
+                for a in agents_after[:5]
+            ]
+        }
+        
+    except Exception as e:
+        logger.error(f"Failed to fix agents data: {e}")
+        raise HTTPException(status_code=500, detail=str(e))
+
+@router.get("/agents-status")
+async def check_agents_status(current_user: dict = Depends(get_current_user)):
+    """Check how many agents need fixing"""
+    if current_user.get("role") not in ["admin", "employee"]:
+        raise HTTPException(status_code=403, detail="Not authorized")
+    
+    try:
+        # Count agents needing fixes
+        result = await database.fetch_one("""
+            SELECT COUNT(*) as count 
+            FROM agents 
+            WHERE name IS NULL OR name = '' OR email IS NULL OR email = ''
+        """)
+        needs_fix = result["count"] if result else 0
+        
+        # Get total agents
+        total_result = await database.fetch_one("SELECT COUNT(*) as count FROM agents")
+        total = total_result["count"] if total_result else 0
+        
+        # Get sample of agents needing fix
+        samples = []
+        if needs_fix > 0:
+            samples = await database.fetch_all("""
+                SELECT agent_id, name, email 
+                FROM agents 
+                WHERE name IS NULL OR name = '' OR email IS NULL OR email = ''
+                LIMIT 5
+            """)
+        
+        return {
+            "total_agents": total,
+            "needs_fix": needs_fix,
+            "all_good": needs_fix == 0,
+            "samples": [
+                {
+                    "agent_id": s["agent_id"],
+                    "current_name": s["name"],
+                    "current_email": s["email"]
+                }
+                for s in samples
+            ]
+        }
+        
+    except Exception as e:
+        logger.error(f"Failed to check agents status: {e}")
+        raise HTTPException(status_code=500, detail=str(e))
