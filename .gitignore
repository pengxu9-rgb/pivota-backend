# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# local sqlite scratch DB created by some dev scripts
pivota.db
pivota_test.db
# Any scratch SQLite DB a test run leaves behind. `git add -A` swept t.db
# into a commit on this branch; a binary artifact must never reach main.
*.db
*.db-journal
*.sqlite
*.sqlite3

# mvp.events file-sink fallback (sqlite/dev runs append to cwd)
mvp_events.jsonl

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GCP env ports (values + integration names) — never commit
infra/gcp/env.*.yaml
infra/gcp/secrets.*.list
infra/gcp/*.local.*

# One-off operational reports from scripts/backfill_stale_pdp_overlays.py. They name
# production pdp_ids and overlay ids and are read once by the operator between the dry
# run and the apply; nothing downstream reads them, so they must not reach main.
reports/pdp_overlay_backfill/
reports/meitu_final_2026_09_07/gateway_env_before.yaml

# local virtualenv symlink — committed by accident in #2164
.venv

# The lint gate plants this in every Python tree to prove the linter still bites, and
# removes it. Ignored so a crashed run cannot leave it to be swept into an unrelated commit --
# this checkout is shared, and that has happened here before. Ignoring it does NOT remove it
# from the gate: ruff.toml sets respect-gitignore = false.
zz_lint_canary_probe.py
