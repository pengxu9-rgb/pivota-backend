# Explicit build-context exclusions. gcloud auto-generates one including .gitignore when this file
# is absent; committing it means a .gitignore change can never silently ship secrets to Cloud Build.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
node_modules
tests
docs
infra/gcp/env.*.yaml
infra/gcp/secrets.*.list
infra/gcp/*.local.*
.env
.env.*
external_seed
# Dev-machine-only state. `.claude` holds harness-managed worktrees — full repo
# copies (dozens on a dev machine). A manual `gcloud builds submit` would ship
# them all into the image via `COPY . .`, and since #1906 the duplicate-
# order_routes.py guard in main.py no longer crashes such a container at boot.
# (`reports/` stays IN the image: it is tracked and read at runtime.)
.claude
.mypy_cache
probe_out
coverage
artifacts
.DS_Store
*.db
*.db-journal
*.sqlite
*.sqlite3
mvp_events.jsonl
